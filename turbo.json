{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "20",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  },
  "globalPassThroughEnv": [
    "CDK_DEFAULT_ACCOUNT",
    "CDK_DEFAULT_REGION",
    "BASE_URL",
    "DEV"
  ]
}
