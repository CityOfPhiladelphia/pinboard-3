{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test:run": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {}
  },
  "globalPassThroughEnv": [
    "CDK_DEFAULT_ACCOUNT",
    "CDK_DEFAULT_REGION",
    "BASE_URL",
    "DEV"
  ]
}
