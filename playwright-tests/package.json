{
  "name": "flood-monitoring-app",
  "version": "1.0.0",
  "description": "Playwright automation for flood monitoring and primary care apps",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "HEADLESS=false npx playwright test",
    "test:headless": "HEADLESS=true npx playwright test",
    "test:primary-care": "npx playwright test primary-care-functional.spec.ts",
    "test:primary-care:headed": "HEADLESS=false npx playwright test primary-care-functional.spec.ts",
    "test:primary-care:headless": "HEADLESS=true npx playwright test primary-care-functional.spec.ts",
    "test:primary-care-results": "npx playwright test primary-care-result-cards.spec.ts",
    "test:primary-care-results:headed": "HEADLESS=false npx playwright test primary-care-result-cards.spec.ts",
    "test:primary-care-results:headless": "HEADLESS=true npx playwright test primary-care-result-cards.spec.ts",
    "test:primary-care-accessibility": "npx playwright test primary-care-accessibility-keyboard.spec.ts",
    "test:primary-care-accessibility:headed": "HEADLESS=false npx playwright test primary-care-accessibility-keyboard.spec.ts",
    "test:primary-care-accessibility:headless": "HEADLESS=true npx playwright test primary-care-accessibility-keyboard.spec.ts",
    "test:primary-care-mobile": "npx playwright test primary-care-mobile.spec.ts",
    "test:primary-care-mobile:headed": "HEADLESS=false npx playwright test primary-care-mobile.spec.ts",
    "test:primary-care-mobile:headless": "HEADLESS=true npx playwright test primary-care-mobile.spec.ts",
    "test:report": "npx playwright show-report",
    "format": "prettier --write .",
    "postinstall": "npx playwright install --with-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^25.6.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
