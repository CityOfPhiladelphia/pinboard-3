{
  "name": "@pinboard/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/pro-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@phila/phila-ui-app-footer": "1.2.3-beta.1",
    "@phila/phila-ui-app-header": "0.3.0-beta.5",
    "@phila/phila-ui-button": "2.2.3-beta.1",
    "@phila/phila-ui-cards": "0.2.0-beta.2",
    "@phila/phila-ui-core": "2.3.3-beta.1",
    "@phila/phila-ui-map-core": "1.0.1-beta.7",
    "@phila/phila-ui-menu": "0.1.1-beta.1",
    "@phila/phila-ui-search": "1.1.3-beta.1",
    "@phila/phila-ui-tags": "0.0.1-beta.1",
    "@phila/phila-ui-text-field": "1.1.3-beta.1",
    "@phila/phila-ui-bottom-sheet": "0.0.1-beta.5",
    "@pinboard/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.1",
    "vue-tsc": "^2.2.0",
    "typescript": "^5.9.3"
  }
}
