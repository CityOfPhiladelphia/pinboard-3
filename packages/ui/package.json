{
  "name": "@pinboard/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/pro-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@phila/phila-ui-app-footer": "1.2.3-beta.6",
    "@phila/phila-ui-app-header": "1.0.0-beta.14",
    "@phila/phila-ui-bottom-sheet": "0.1.0-beta.10",
    "@phila/phila-ui-button": "2.2.3-beta.6",
    "@phila/phila-ui-cards": "0.2.0-beta.8",
    "@phila/phila-ui-checkbox": "0.1.1-beta.6",
    "@phila/phila-ui-core": "3.0.0-beta.5",
    "@phila/phila-ui-filter-chip": "0.2.0-beta.3",
    "@phila/phila-ui-filter-panel": "0.1.0-beta.0",
    "@phila/phila-ui-link": "1.0.4-beta.5",
    "@phila/phila-ui-map-core": "1.1.0-beta.17",
    "@phila/phila-ui-menu": "0.1.1-beta.7",
    "@phila/phila-ui-radio": "0.1.1-beta.6",
    "@phila/phila-ui-search": "1.2.0-beta.8",
    "@phila/phila-ui-tags": "0.1.0-beta.6",
    "@phila/phila-ui-text-field": "1.1.3-beta.7",
    "@pinboard/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "vue-i18n": "^11.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vue-i18n": "^11.0.1"
  }
}
