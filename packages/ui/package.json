{
  "name": "@pinboard/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phila/phila-ui-core": "catalog:",
    "@phila/phila-ui-tabs": "catalog:",
    "@phila/phila-ui-button": "catalog:",
    "@phila/phila-ui-tags": "catalog:",
    "@phila/phila-ui-tooltip": "catalog:",
    "@phila/phila-ui-bottom-sheet": "catalog:",
    "@phila/phila-ui-charts": "catalog:",
    "@phila/phila-ui-link": "catalog:",
    "@phila/phila-ui-logo": "catalog:",
    "@phila/phila-ui-table": "catalog:",
    "@phila/phila-ui-app-footer": "catalog:",
    "@phila/phila-ui-app-header": "catalog:",
    "@phila/phila-ui-callout": "catalog:",
    "@phila/phila-ui-cards": "catalog:",
    "@phila/phila-ui-checkbox": "catalog:",
    "@phila/phila-ui-filter-chip": "catalog:",
    "@phila/phila-ui-filter-panel": "catalog:",
    "@phila/phila-ui-map-core": "catalog:",
    "@phila/phila-ui-menu": "catalog:",
    "@phila/phila-ui-radio": "catalog:",
    "@phila/phila-ui-search": "catalog:",
    "@phila/phila-ui-text-field": "catalog:",
    "@pinboard/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-i18n": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "npm-run-all2": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
