{
  "extends": [
    "@tsconfig/node24/tsconfig.json",
    "@vue/tsconfig/tsconfig.json",
    "./base.json"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "eslint.config.mjs",
    "vite.config.ts"
  ],
  "types": ["node", "vue"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@vue/typescript-plugin"
      }
    ]
  }
}
