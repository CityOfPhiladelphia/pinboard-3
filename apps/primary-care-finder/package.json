{
  "name": "primary-care-finder",
  "version": "1.0.0",
  "description": "Static site with CloudFront CDN",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:frontend": "cd frontend && pnpm run build",
    "dev": "cd frontend && pnpm run dev",
    "test": "pnpm -r test --if-present",
    "synth": "cd cdk && cdk synth",
    "deploy": "cd cdk && cdk deploy",
    "diff": "cd cdk && cdk diff"
  },
  "workspaces": [
    "cdk",
    "frontend"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "aws-cdk-lib": "2.236.0",
    "constructs": "10.4.4"
  }
}
