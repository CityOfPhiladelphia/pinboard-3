{
  "name": "pinboard-3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:oem": "pnpm --filter @pinboard/oem-flood-finder dev",
    "dev:pc": "pnpm --filter @pinboard/primary-care-finder dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "overrides": {
      "@fortawesome/fontawesome-common-types": "7.1.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2",
      "vite@>=6.0.0 <=6.4.1": ">=6.4.2",
      "protocol-buffers-schema@<3.6.1": ">=3.6.1",
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
