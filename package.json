{
  "name": "pinboard-3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:no-concur": "pnpm build --concurrency=1",
    "dev": "turbo run dev",
    "dev:oem": "pnpm --filter @pinboard/oem-flood-finder dev",
    "dev:oem:fresh": "pnpm --filter @pinboard/oem-flood-finder dev:fresh",
    "dev:pc": "pnpm --filter @pinboard/primary-care-finder dev",
    "dev:pc:fresh": "pnpm --filter @pinboard/primary-care-finder dev:fresh",
    "dev:311": "pnpm --filter @pinboard/philly-311 dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.10.11",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "vue-router": "5.0.6",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "postcss@<=8.5.22": ">=8.5.23",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "dompurify@<=3.4.12": ">=3.4.13",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18"
    }
  }
}
