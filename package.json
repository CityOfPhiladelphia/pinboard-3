    "dev:pc": "pnpm --filter @pinboard/primary-care-finder dev",
    "dev:pc:fresh": "pnpm --filter @pinboard/primary-care-finder dev:fresh",
    "dev:311": "pnpm --filter @pinboard/philly-311 dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "vue-router": "5.0.6",
      "@phila/phila-ui-app-footer": "link:../phila-ui-4/packages/app-footer",
